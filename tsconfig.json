{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "es2023",
      "dom",
      "dom.iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [],
    "paths": {
      "video-timeline-scrubber": [
        "./src/index.ts"
      ],
      "video-timeline-scrubber/react": [
        "./src/react/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "demo"
  ]
}